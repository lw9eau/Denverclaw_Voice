# secrets.yaml.example — Example file for ESPHome secrets
# Copy this file to secrets.yaml and fill in your actual credentials
# DO NOT upload your actual secrets.yaml to any public repository

wifi_ssid: "your_wifi_name_here"
wifi_password: "your_wifi_password_here"
ota_password: "your_ota_password_here"

# Generate your key with: openssl rand -base64 32
api_encryption_key: "your_base64_encryption_key_here="

# Denver Voice Server IP or Hostname
voice_server_host: "192.168.1.100"
